{
  "name": "@alexisayenko/bloodtests-ui",
  "version": "0.0.0",
  "description": "Framework-agnostic <lab-matrix> web component that renders the bloodtests-engine view-model. Works in any HTML page (Eleventy, plain static, …).",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepare": "tsup"
  },
  "devDependencies": {
    "@alexisayenko/bloodtests-engine": "file:../engine",
    "@types/node": "^26.1.0",
    "happy-dom": "^15.11.0",
    "tsup": "^8.5.1",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "license": "MIT"
}
